# Base URL of the hrms-backend Laravel API (must include the /api prefix)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Must match hrms-backend's JWT_AUTH_COOKIE value (config/jwt.php).
# Used only to decide, at the edge, whether a session cookie is present —
# the cookie is httpOnly so its value is never read by client JS.
NEXT_PUBLIC_AUTH_COOKIE_NAME=hrms_auth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
